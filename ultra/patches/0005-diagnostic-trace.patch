diff --git a/app/module/include/zmk/dwerty_diag.h b/app/module/include/zmk/dwerty_diag.h
new file mode 100644
index 0000000..4c66a99
--- /dev/null
+++ b/app/module/include/zmk/dwerty_diag.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <zephyr/sys/util.h>
+
+enum dwerty_diag_event_type {
+    DWERTY_DIAG_EVENT_BOOT = 1,
+    DWERTY_DIAG_EVENT_ARM = 2,
+    DWERTY_DIAG_EVENT_MATRIX_RAW = 3,
+    DWERTY_DIAG_EVENT_KSCAN = 4,
+    DWERTY_DIAG_EVENT_KSCAN_DROP = 5,
+    DWERTY_DIAG_EVENT_POSITION = 6,
+    DWERTY_DIAG_EVENT_KEYMAP = 7,
+    DWERTY_DIAG_EVENT_MODIFIER = 8,
+    DWERTY_DIAG_EVENT_HID_CLEAR = 9,
+    DWERTY_DIAG_EVENT_HID_REPORT = 10,
+    DWERTY_DIAG_EVENT_HID_SEND = 11,
+    DWERTY_DIAG_EVENT_PPT_QUEUE = 12,
+    DWERTY_DIAG_EVENT_PPT_TX = 13,
+    DWERTY_DIAG_EVENT_PPT_STATE = 14,
+    DWERTY_DIAG_EVENT_ENDPOINT = 15,
+    DWERTY_DIAG_EVENT_FREEZE = 16,
+    DWERTY_DIAG_EVENT_MARK = 17,
+};
+
+enum dwerty_diag_freeze_reason {
+    DWERTY_DIAG_FREEZE_HOST = 1,
+    DWERTY_DIAG_FREEZE_SUSPICIOUS_MODIFIERS = 2,
+    DWERTY_DIAG_FREEZE_KSCAN_OVERFLOW = 3,
+    DWERTY_DIAG_FREEZE_PPT_OVERFLOW = 4,
+    DWERTY_DIAG_FREEZE_PPT_SEND = 5,
+    DWERTY_DIAG_FREEZE_MODIFIER_UNDERFLOW = 6,
+};
+
+#define DWERTY_DIAG_FLAG_PRESSED BIT(0)
+#define DWERTY_DIAG_FLAG_ERROR BIT(1)
+#define DWERTY_DIAG_FLAG_DISCARDED BIT(2)
+
+#if IS_ENABLED(CONFIG_DWERTY_DIAGNOSTICS)
+
+void dwerty_diag_record(uint8_t type, uint8_t flags, uint16_t arg0, uint16_t arg1);
+void dwerty_diag_record_hid(uint8_t transport, const uint8_t *report, size_t len);
+void dwerty_diag_freeze(uint8_t reason);
+uint32_t dwerty_diag_generation(void);
+
+#else
+
+#define dwerty_diag_record(...) ((void)0)
+#define dwerty_diag_record_hid(...) ((void)0)
+#define dwerty_diag_freeze(...) ((void)0)
+
+#endif
diff --git a/app/src/dwerty_diag.c b/app/src/dwerty_diag.c
new file mode 100644
index 0000000..1d7ea53
--- /dev/null
+++ b/app/src/dwerty_diag.c
@@ -0,0 +1,345 @@
+#include <zephyr/device.h>
+#include <zephyr/init.h>
+#include <zephyr/kernel.h>
+#include <zephyr/spinlock.h>
+#include <zephyr/sys/atomic.h>
+#include <zephyr/sys/byteorder.h>
+
+#include <string.h>
+
+#if IS_ENABLED(CONFIG_DWERTY_DIAGNOSTICS_UART)
+#include <zephyr/drivers/uart.h>
+#endif
+
+#include <zmk/dwerty_diag.h>
+
+#define DWERTY_DIAG_COMMAND 0xD0
+#define DWERTY_DIAG_PROTOCOL_VERSION 1
+#define DWERTY_DIAG_SUBCOMMAND_INFO 0
+#define DWERTY_DIAG_SUBCOMMAND_READ 1
+#define DWERTY_DIAG_SUBCOMMAND_ARM 2
+#define DWERTY_DIAG_SUBCOMMAND_FREEZE 3
+#define DWERTY_DIAG_SUBCOMMAND_MARK 4
+#define DWERTY_DIAG_REPORT_SIZE 32
+#define DWERTY_DIAG_READ_HEADER_SIZE 8
+#define DWERTY_DIAG_UART_MAGIC_0 0xD7
+#define DWERTY_DIAG_UART_MAGIC_1 0x59
+
+struct dwerty_diag_record {
+    uint16_t sequence;
+    uint8_t type;
+    uint8_t flags;
+    uint32_t uptime_ms;
+    uint16_t arg0;
+    uint16_t arg1;
+} __packed;
+
+BUILD_ASSERT(sizeof(struct dwerty_diag_record) == 12);
+BUILD_ASSERT(CONFIG_DWERTY_DIAGNOSTICS_BUFFER_SIZE <= UINT16_MAX);
+
+static struct dwerty_diag_record records[CONFIG_DWERTY_DIAGNOSTICS_BUFFER_SIZE];
+static struct k_spinlock lock;
+static uint16_t head;
+static uint16_t count;
+static uint32_t next_sequence;
+static uint32_t overwritten;
+static bool frozen;
+static uint8_t freeze_reason;
+static uint8_t trigger_reason;
+static uint8_t trigger_remaining;
+static atomic_t generation;
+static atomic_t uart_dropped;
+
+void raw_hid_send(uint8_t *data, uint8_t length);
+
+static uint16_t dwerty_diag_crc16(const uint8_t *data, size_t len) {
+    uint16_t crc = 0xFFFF;
+
+    for (size_t i = 0; i < len; i++) {
+        crc ^= (uint16_t)data[i] << 8;
+        for (uint8_t bit = 0; bit < 8; bit++) {
+            crc = (crc & 0x8000) ? (crc << 1) ^ 0x1021 : crc << 1;
+        }
+    }
+
+    return crc;
+}
+
+#if IS_ENABLED(CONFIG_DWERTY_DIAGNOSTICS_UART)
+
+K_MSGQ_DEFINE(dwerty_diag_uart_msgq, sizeof(struct dwerty_diag_record), 128, 4);
+static const struct device *const dwerty_diag_uart =
+    DEVICE_DT_GET(DT_CHOSEN(zephyr_console));
+
+BUILD_ASSERT(!IS_ENABLED(CONFIG_CONSOLE),
+             "Dwerty UART diagnostics require CONFIG_CONSOLE=n");
+BUILD_ASSERT(!IS_ENABLED(CONFIG_UART_CONSOLE),
+             "Dwerty UART diagnostics require CONFIG_UART_CONSOLE=n");
+
+static void dwerty_diag_uart_thread(void *unused1, void *unused2, void *unused3) {
+    struct dwerty_diag_record record;
+    uint8_t frame[2 + sizeof(record) + sizeof(uint16_t)];
+
+    (void)unused1;
+    (void)unused2;
+    (void)unused3;
+    while (k_msgq_get(&dwerty_diag_uart_msgq, &record, K_FOREVER) == 0) {
+        if (!device_is_ready(dwerty_diag_uart)) {
+            atomic_inc(&uart_dropped);
+            continue;
+        }
+        frame[0] = DWERTY_DIAG_UART_MAGIC_0;
+        frame[1] = DWERTY_DIAG_UART_MAGIC_1;
+        memcpy(&frame[2], &record, sizeof(record));
+        sys_put_le16(dwerty_diag_crc16(frame, sizeof(frame) - sizeof(uint16_t)),
+                     &frame[sizeof(frame) - sizeof(uint16_t)]);
+
+        for (size_t i = 0; i < sizeof(frame); i++) {
+            uart_poll_out(dwerty_diag_uart, frame[i]);
+        }
+    }
+}
+
+K_THREAD_DEFINE(dwerty_diag_uart_thread_id, 1024, dwerty_diag_uart_thread, NULL, NULL, NULL,
+                K_LOWEST_APPLICATION_THREAD_PRIO, 0, 0);
+
+static void dwerty_diag_stream(const struct dwerty_diag_record *record) {
+    if (k_msgq_put(&dwerty_diag_uart_msgq, record, K_NO_WAIT) < 0) {
+        atomic_inc(&uart_dropped);
+        return;
+    }
+}
+
+#else
+
+static void dwerty_diag_stream(const struct dwerty_diag_record *record) { (void)record; }
+
+#endif
+
+static void dwerty_diag_append_locked(uint8_t type, uint8_t flags, uint16_t arg0, uint16_t arg1,
+                                      struct dwerty_diag_record *record) {
+    *record = (struct dwerty_diag_record){
+        .sequence = (uint16_t)next_sequence++,
+        .type = type,
+        .flags = flags,
+        .uptime_ms = k_uptime_get_32(),
+        .arg0 = arg0,
+        .arg1 = arg1,
+    };
+
+    if (count == CONFIG_DWERTY_DIAGNOSTICS_BUFFER_SIZE) {
+        head = (head + 1) % CONFIG_DWERTY_DIAGNOSTICS_BUFFER_SIZE;
+        overwritten++;
+    } else {
+        count++;
+    }
+
+    uint16_t index = (head + count - 1) % CONFIG_DWERTY_DIAGNOSTICS_BUFFER_SIZE;
+    records[index] = *record;
+}
+
+void dwerty_diag_record(uint8_t type, uint8_t flags, uint16_t arg0, uint16_t arg1) {
+    struct dwerty_diag_record record;
+    struct dwerty_diag_record freeze_record;
+    bool appended = false;
+    bool freeze_appended = false;
+
+    k_spinlock_key_t key = k_spin_lock(&lock);
+    if (!frozen) {
+        dwerty_diag_append_locked(type, flags, arg0, arg1, &record);
+        appended = true;
+        if (trigger_remaining > 0 && --trigger_remaining == 0) {
+            dwerty_diag_append_locked(DWERTY_DIAG_EVENT_FREEZE, 0, trigger_reason, 0,
+                                      &freeze_record);
+            freeze_reason = trigger_reason;
+            trigger_reason = 0;
+            frozen = true;
+            freeze_appended = true;
+        }
+    }
+    k_spin_unlock(&lock, key);
+
+    if (appended) {
+        dwerty_diag_stream(&record);
+    }
+    if (freeze_appended) {
+        dwerty_diag_stream(&freeze_record);
+    }
+}
+
+void dwerty_diag_freeze(uint8_t reason) {
+    struct dwerty_diag_record record;
+    bool appended = false;
+
+    k_spinlock_key_t key = k_spin_lock(&lock);
+    if (!frozen) {
+        dwerty_diag_append_locked(DWERTY_DIAG_EVENT_FREEZE, 0, reason, 0, &record);
+        freeze_reason = reason;
+        trigger_reason = 0;
+        trigger_remaining = 0;
+        frozen = true;
+        appended = true;
+    }
+    k_spin_unlock(&lock, key);
+
+    if (appended) {
+        dwerty_diag_stream(&record);
+    }
+}
+
+void dwerty_diag_record_hid(uint8_t transport, const uint8_t *report, size_t len) {
+    if (report == NULL || len < 2) {
+        return;
+    }
+
+    uint8_t modifiers = report[0];
+    uint16_t state = modifiers | ((uint16_t)report[1] << 8);
+    dwerty_diag_record(DWERTY_DIAG_EVENT_HID_REPORT, transport, state,
+                       dwerty_diag_crc16(report, len));
+
+    if (__builtin_popcount((unsigned int)modifiers) >= 4) {
+        k_spinlock_key_t key = k_spin_lock(&lock);
+        if (!frozen && trigger_remaining == 0) {
+            trigger_reason = DWERTY_DIAG_FREEZE_SUSPICIOUS_MODIFIERS;
+            trigger_remaining = 8;
+        }
+        k_spin_unlock(&lock, key);
+    }
+}
+
+uint32_t dwerty_diag_generation(void) {
+    return (uint32_t)atomic_get(&generation);
+}
+
+static void dwerty_diag_reset(void) {
+    struct dwerty_diag_record record;
+
+#if IS_ENABLED(CONFIG_DWERTY_DIAGNOSTICS_UART)
+    k_msgq_purge(&dwerty_diag_uart_msgq);
+#endif
+    k_spinlock_key_t key = k_spin_lock(&lock);
+    head = 0;
+    count = 0;
+    next_sequence = 0;
+    overwritten = 0;
+    frozen = false;
+    freeze_reason = 0;
+    trigger_reason = 0;
+    trigger_remaining = 0;
+    atomic_inc(&generation);
+    atomic_set(&uart_dropped, 0);
+    dwerty_diag_append_locked(DWERTY_DIAG_EVENT_ARM, 0, 0, 0, &record);
+    k_spin_unlock(&lock, key);
+
+    dwerty_diag_stream(&record);
+}
+
+static void dwerty_diag_fill_info(uint8_t *data, uint8_t subcommand) {
+    uint16_t snapshot_count;
+    uint32_t snapshot_next;
+    uint32_t snapshot_overwritten;
+    bool snapshot_frozen;
+    uint8_t snapshot_reason;
+    uint8_t snapshot_trigger_remaining;
+    uint8_t snapshot_trigger_reason;
+
+    k_spinlock_key_t key = k_spin_lock(&lock);
+    snapshot_count = count;
+    snapshot_next = next_sequence;
+    snapshot_overwritten = overwritten;
+    snapshot_frozen = frozen;
+    snapshot_reason = freeze_reason;
+    snapshot_trigger_remaining = trigger_remaining;
+    snapshot_trigger_reason = trigger_reason;
+    k_spin_unlock(&lock, key);
+
+    memset(data, 0, DWERTY_DIAG_REPORT_SIZE);
+    data[0] = DWERTY_DIAG_COMMAND;
+    data[1] = subcommand;
+    data[2] = 0;
+    data[3] = DWERTY_DIAG_PROTOCOL_VERSION;
+    data[4] = sizeof(struct dwerty_diag_record);
+    sys_put_le16(CONFIG_DWERTY_DIAGNOSTICS_BUFFER_SIZE, &data[5]);
+    sys_put_le16(snapshot_count, &data[7]);
+    sys_put_le16((uint16_t)snapshot_next, &data[9]);
+    data[11] = snapshot_frozen;
+    data[12] = snapshot_reason;
+    sys_put_le32(snapshot_overwritten, &data[13]);
+    sys_put_le32((uint32_t)atomic_get(&uart_dropped), &data[17]);
+    sys_put_le32(k_uptime_get_32(), &data[21]);
+    data[25] = snapshot_trigger_remaining;
+    data[26] = snapshot_trigger_reason;
+    sys_put_le32(snapshot_next, &data[27]);
+}
+
+static void dwerty_diag_fill_records(uint8_t *data, uint16_t requested_index) {
+    struct dwerty_diag_record result[2];
+    uint8_t returned = 0;
+
+    k_spinlock_key_t key = k_spin_lock(&lock);
+    while (returned < ARRAY_SIZE(result) && requested_index + returned < count) {
+        uint16_t index =
+            (head + requested_index + returned) % CONFIG_DWERTY_DIAGNOSTICS_BUFFER_SIZE;
+        result[returned] = records[index];
+        returned++;
+    }
+    k_spin_unlock(&lock, key);
+
+    memset(data, 0, DWERTY_DIAG_REPORT_SIZE);
+    data[0] = DWERTY_DIAG_COMMAND;
+    data[1] = DWERTY_DIAG_SUBCOMMAND_READ;
+    data[2] = 0;
+    data[3] = returned;
+    sys_put_le16(requested_index, &data[4]);
+    data[6] = sizeof(struct dwerty_diag_record);
+    data[7] = DWERTY_DIAG_PROTOCOL_VERSION;
+    memcpy(&data[DWERTY_DIAG_READ_HEADER_SIZE], result, returned * sizeof(result[0]));
+}
+
+bool launcher_command_kb(uint8_t *data, uint8_t length) {
+    if (length != DWERTY_DIAG_REPORT_SIZE || data[0] != DWERTY_DIAG_COMMAND) {
+        return false;
+    }
+
+    uint8_t subcommand = data[1];
+    uint16_t requested_index = sys_get_le16(&data[2]);
+    uint32_t marker = sys_get_le32(&data[2]);
+
+    switch (subcommand) {
+    case DWERTY_DIAG_SUBCOMMAND_INFO:
+        dwerty_diag_fill_info(data, subcommand);
+        break;
+    case DWERTY_DIAG_SUBCOMMAND_READ:
+        dwerty_diag_fill_records(data, requested_index);
+        break;
+    case DWERTY_DIAG_SUBCOMMAND_ARM:
+        dwerty_diag_reset();
+        dwerty_diag_fill_info(data, subcommand);
+        break;
+    case DWERTY_DIAG_SUBCOMMAND_FREEZE:
+        dwerty_diag_freeze(DWERTY_DIAG_FREEZE_HOST);
+        dwerty_diag_fill_info(data, subcommand);
+        break;
+    case DWERTY_DIAG_SUBCOMMAND_MARK:
+        dwerty_diag_record(DWERTY_DIAG_EVENT_MARK, 0, marker & 0xFFFF, marker >> 16);
+        dwerty_diag_fill_info(data, subcommand);
+        sys_put_le32(marker, &data[27]);
+        break;
+    default:
+        memset(data, 0, DWERTY_DIAG_REPORT_SIZE);
+        data[0] = DWERTY_DIAG_COMMAND;
+        data[1] = subcommand;
+        data[2] = 1;
+        break;
+    }
+
+    raw_hid_send(data, length);
+    return true;
+}
+
+static int dwerty_diag_init(void) {
+    dwerty_diag_record(DWERTY_DIAG_EVENT_BOOT, 0, 0, 0);
+    return 0;
+}
+
+SYS_INIT(dwerty_diag_init, APPLICATION, CONFIG_APPLICATION_INIT_PRIORITY);
